# Minimale .config für FS/NFSD Development
# Diese Datei kann als Basis für Kernel-Builds genutzt werden

# ===== KERNEL BASICS =====
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_PREEMPT=y

# ===== FILESYSTEM SUPPORT =====
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# ===== NFSD (NFS Server) =====
CONFIG_NFSD=y
CONFIG_NFSD_V3=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_V4_2=y
CONFIG_NFSD_PNFS=y

# ===== NFS Client (zum Testen) =====
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y

# ===== NETWORK =====
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV4=y
CONFIG_IPV6=y
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
CONFIG_GRACE_PERIOD=y

# ===== SECURITY & LSM =====
CONFIG_SECURITY=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_PATH=y

# ===== BPF Support =====
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y

# ===== DEBUGGING =====
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_FRAME_POINTER=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_KRETPROBES=y

# ===== BUILD OPTIONS =====
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_WERROR=n
